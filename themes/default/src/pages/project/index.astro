---
import Base from '../../../layouts/Base.astro'
import { fetchAPI } from '../../lib/api'

let items: any[] = []
try {
  const res = await fetchAPI('/project?status=published&limit=100')
  items = res.data || []
} catch {}
---
<Base title="Projects">
  <section>
    <h1>Projects</h1>
    {items.length === 0 ? (
      <p class="empty">No projects published yet.</p>
    ) : (
      <div class="grid">
        {items.map((item: any) => (
          <a href={`/project/${item.slug || item.id}`} class="card">
            <h2>{item.title}</h2>
            {item.tags?.length > 0 && (
              <div class="card-tags">
                {item.tags.map((tag: string) => <span>{tag}</span>)}
              </div>
            )}
          </a>
        ))}
      </div>
    )}
  </section>
</Base>

<style>
  h1 { margin-bottom: var(--space-xl); }
  .empty { color: var(--color-text-muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-lg); }
  .card { padding: var(--space-lg); border: 1px solid var(--color-border); border-radius: 0.75rem; text-decoration: none; transition: border-color 0.15s; }
  .card:hover { border-color: var(--color-accent); text-decoration: none; }
  .card h2 { font-size: 1.125rem; color: var(--color-primary); margin-bottom: var(--space-sm); }
  .card-tags { display: flex; gap: var(--space-xs); flex-wrap: wrap; }
  .card-tags span { font-size: 0.75rem; color: var(--color-text-muted); background: var(--color-bg-alt, #f3f4f6); padding: 0.15rem 0.5rem; border-radius: 1rem; }
</style>
