---
import Base from '../../layouts/Base.astro'
---
<Base title="Page not found">
  <section class="not-found">
    <h1>404</h1>
    <p>This page doesn't exist.</p>
    <a href="/">Go home</a>
  </section>
</Base>

<style>
  .not-found { text-align: center; padding: var(--space-2xl) 0; }
  .not-found h1 { font-size: 5rem; color: var(--color-text-muted); margin-bottom: var(--space-sm); }
  .not-found p { color: var(--color-text-muted); margin-bottom: var(--space-lg); }
  .not-found a { display: inline-block; padding: 0.5rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; color: var(--color-primary); text-decoration: none; }
  .not-found a:hover { border-color: var(--color-accent); }
</style>
