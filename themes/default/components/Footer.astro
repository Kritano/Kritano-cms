---
interface Props {
  text?: string
}
const { text } = Astro.props
---
<footer class="footer">
  <p>{text || `© ${new Date().getFullYear()}. Built with Kritano CMS.`}</p>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-lg) 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    text-align: center;
  }
</style>
