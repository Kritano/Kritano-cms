{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"],
      "@kritano/cms/core": ["../core/src/index.ts"],
      "@kritano/cms/types": ["../types/dist/index.d.ts", "../types/src/index.ts"],
      "@kritano/cms/sdk": ["../sdk/dist/index.d.ts", "../sdk/src/index.ts"]
    }
  },
  "include": ["src"]
}
