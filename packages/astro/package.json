{
  "name": "@kritano/astro",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun && bun run typecheck",
    "typecheck": "tsc --emitDeclarationOnly"
  },
  "dependencies": {
    "@kritano/sdk": "workspace:*",
    "@kritano/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "bun-types": "^1.3.0"
  }
}
