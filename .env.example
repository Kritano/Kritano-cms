REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-random-secret
MEDIA_PATH=./media
SITE_URL=http://localhost:4321
ADMIN_URL=http://localhost:3002/admin
PORT=3001

# GDPR audit-log HMAC key. Set to a long random string, e.g. `openssl rand -hex 32`.
# Required only if you process personal data via forms/collections and use the
# GDPR admin tooling (/admin/gdpr). NEVER rotate this once set — rotation
# breaks the audit-log continuity for every historic deletion. Treat it like
# a database encryption key. See docs/gdpr.md.
GDPR_AUDIT_SECRET=
