{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["bun-types"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@kritano/cms/core": ["./packages/core/src/index.ts"],
      "@kritano/cms/types": ["./packages/types/dist/index.d.ts", "./packages/types/src/index.ts"],
      "@kritano/cms/sdk": ["./packages/sdk/dist/index.d.ts", "./packages/sdk/src/index.ts"],
      "@kritano/cms/astro": ["./packages/astro/src/index.ts"],
      "@kritano/cms/cli": ["./packages/cli/src/index.ts"],
      "@kritano/cms/mcp": ["./packages/mcp/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
